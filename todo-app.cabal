cabal-version: 3.0
name: todo-app
version: 0.1.0.0
build-type: Simple

common defaults
  ghc-options: -Wall
  build-depends:
    base,
    relude,

  hs-source-dirs: src
  default-language: Haskell2010
  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude),
    relude,

executable backend
  import: defaults
  main-is: Backend.hs

executable site
  import: defaults
  main-is: Site.hs
  build-depends:
    blaze-html,
    hakyll,

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
